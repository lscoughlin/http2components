 function TMacOSRandomProvider.GenRandomBytesMacOS(ALen: Int32;
   AData: PByte): Int32;
+{$IFDEF FPC}
 var
+  LFd: cint;
+  LRead: ssize_t;
+  LOffset: Int32;
+begin
+  Result := -1;
+  if (ALen < 0) or ((ALen > 0) and (AData = nil)) then
+    Exit;
+  if ALen = 0 then
+  begin
+    Result := 0;
+    Exit;
+  end;
+
+  repeat
+    LFd := fpOpen(PChar(DevRandomPath), O_RdOnly);
+  until (LFd >= 0) or (fpgeterrno <> ESysEINTR);
+  if LFd < 0 then
+    Exit;
+  try
+    LOffset := 0;
+    while LOffset < ALen do
+    begin
+      LRead := fpRead(LFd, (AData + LOffset)^, ALen - LOffset);
+      if LRead < 0 then
+      begin
+        if fpgeterrno = ESysEINTR then
+          Continue;
+        Exit;
+      end;
+      if LRead = 0 then
+        Exit;
+      Inc(LOffset, LRead);
+    end;
+    Result := 0;
+  finally
+    fpClose(LFd);
+  end;
+end;
+{$ELSE}
+var
   LUseSec: Boolean;
 begin
