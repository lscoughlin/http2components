<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="/" />
    <Name Value="http2clientreaders" />
    <Type Value="RunTimeOnly" />
    <Author Value="Liam Seamus Coughlin" />
    <Description Value="HTTP/2 clientreaders library for Free Pascal" />
    <Version Major="0" Minor="33" Release="0" Build="0" />
    <License Value="Apache-2.0 OR (LGPL-2.1-only WITH Independent-modules-exception)" />
    <CompilerOptions>
      <Version Value="11" />
      <Other>
        <CustomOptions Value="-Fl../third_party/mORMot2/static/$(TargetCPU)-$(TargetOS)" />
      </Other>
      <SearchPaths>
        <IncludeFiles Value="../common/src;src" />
        <UnitOutputDirectory Value="../bin/$(TargetCPU)-$(TargetOS)/default/package-http2clientreaders/units" />
        <OtherUnitFiles Value="src;../third_party/mORMot2/src/core;../third_party/mORMot2/src/lib" />
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <SyntaxMode Value="Delphi" />
          <IncludeAssertionCode Value="True" />
        </SyntaxOptions>
      </Parsing>
    </CompilerOptions>
    <Files Count="1">
      <Item1>
        <Filename Value="src/Http2.Client.Readers.pas" />
        <UnitName Value="Http2.Client.Readers" />
      </Item1>
    </Files>
    <RequiredPkgs Count="3">
      <Item1>
        <PackageName Value="FCL" />
      </Item1>
      <Item2>
        <PackageName Value="http2common" />
      </Item2>
      <Item3>
        <PackageName Value="http2client" />
      </Item3>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)" />
    </UsageOptions>
  </Package>
</CONFIG>
